<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Lecture d'un enseignement en arrière-plan (#39). Le manifeste
         d'`audio_service` est **vide** : tout ce qui suit est à la charge de
         l'application, rien n'est fusionné automatiquement. -->
    <!-- Garder le processeur éveillé pendant qu'un prêche joue, écran éteint. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Le service de premier plan, et son type depuis Android 14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Le téléchargement offline des enseignements (#190). `background_downloader`
         télécharge en tâche de fond via un service de premier plan de type
         `dataSync` (déclaré dans le manifeste du greffon, fusionné ici) : depuis
         Android 14, ce type exige sa propre permission. `FOREGROUND_SERVICE`
         ci-dessus et `POST_NOTIFICATIONS` ci-dessous (notification de
         progression) sont déjà là pour le lecteur — le greffon les réutilise. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Android 13+. C'est une permission **d'exécution** : la déclarer ici ne
         suffit pas, et `audio_service` ne la demande pas. Sans la demande faite
         par l'application (voir `MainActivity.kt` et
         `playback_notifications.dart`), la notification de lecture
         n'apparaît jamais — silencieusement.

         ⚠️ Depuis #97, **trois** besoins partagent cette seule permission : la
         notification du lecteur, celle du téléchargement, et la notification
         locale du réveil push. Elle n'est demandée qu'**une fois**, au démarrage :
         la redemander afficherait deux fenêtres l'une sur l'autre au premier
         lancement. Et son refus ne coupe aucun des trois mécanismes — il ne coupe
         que leur affichage ; le réveil silencieux de FCM, lui, arrive sans aucune
         permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Enregistrer un média partagé dans la galerie (gal). Nécessaire seulement
         jusqu'à Android 9 (API 28) : dès API 29 le MediaStore n'exige plus
         d'autorisation d'écriture. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- Les médias de la messagerie (M4, #143). Toutes demandées **au geste**,
         jamais au lancement :
         - RECORD_AUDIO : au premier appui maintenu sur le micro (vocal) ;
         - ACCESS_FINE/COARSE_LOCATION : quand on choisit « Position » dans la
           feuille du trombone (geolocator), et seulement alors.
         Ni CAMERA (image_picker passe par l'application photo du système), ni
         READ_CONTACTS (le contact est choisi dans le sélecteur du système, qui ne
         livre que lui), ni READ_MEDIA_* (sélecteurs du système). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- `android:label` est le nom **affiché** : ce que le fidèle lit sous
         l'icône de son écran d'accueil. Il ne se confond ni avec le nom du
         paquet Dart (`maison_du_miracle`, que personne ne voit) ni avec
         l'`applicationId` (`com.maisondumiracle.maison_du_miracle`), qui est
         l'identité de l'application auprès du magasin et de la signature —
         aucun des deux ne bouge. -->
    <application
        android:label="Nouvelle Vie"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Le service de lecture d'`audio_service`. `MainActivity` étend
             `AudioServiceActivity` (elle partage le `FlutterEngine` du
             service) : l'activité garde donc son propre nom ici, et c'est le
             `.kt` qui fait le lien. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Boutons du casque, de la voiture et des montres. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Les actions des notifications de messages (M5) — « Répondre » et
             « Marquer comme lu ». Le greffon `flutter_local_notifications` les
             reçoit par ce récepteur, puis démarre un isolate de fond
             (`wakeActionEntryPoint`). Sans cette ligne, les deux boutons
             s'affichent et ne font **rien**, sans aucune erreur. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- M4 (#143) : ouvrir une position dans l'application de cartes, un
             numéro de contact dans le composeur, une page de carte en repli. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
