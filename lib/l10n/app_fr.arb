  "legalGateTitleFirst": "Avant de commencer",
  "@legalGateTitleFirst": { "description": "Titre de la barrière de consentement à la PREMIÈRE acceptation — déduit d'un résumé d'acceptation vide. Dire « nos conditions ont changé » à quelqu'un qui n'en a jamais lu aucune lui ferait chercher ce qu'il a manqué" },
  "legalGateTitleUpdated": "Nos conditions ont changé",
  "@legalGateTitleUpdated": { "description": "Titre de la barrière de consentement lors d'une RE-acceptation, après révision. Le fidèle concerné est connecté depuis longtemps : ce qu'il doit savoir, c'est que le texte a bougé" },
  "legalGateSubtitle": "Votre accord est nécessaire pour continuer.",
  "@legalGateSubtitle": { "description": "Sous-titre de la barrière, commun aux deux cas. Il dit le blocage sans le déguiser : il n'y a ni « Plus tard », ni croix, ni retour" },
  "legalGateAcceptTerms": "J'ai lu et j'accepte les conditions générales d'utilisation.",
  "@legalGateAcceptTerms": { "description": "Case à cocher des CGU, sur la barrière. Une case PAR document exigé, jamais précochée — une case précochée n'est pas un consentement" },
  "legalGateAcceptPrivacy": "J'ai lu et j'accepte la politique de confidentialité.",
  "@legalGateAcceptPrivacy": { "description": "Case à cocher de la politique de confidentialité, sur la barrière. Si seule la politique a changé, c'est la seule case et le seul document affichés" },
  "legalGateErrorNetwork": "Connexion requise pour enregistrer votre accord.",
  "@legalGateErrorNetwork": { "description": "Refus d'enregistrement, serveur injoignable. Le document se lit hors ligne (il vient du magasin), l'accord ne s'enregistre pas : pas de file d'envoi, pas d'état « accepté, non confirmé » (ADR-0036, décision 2). Suivi de « Réessayer »" },
  "legalGateErrorUnauthorized": "Votre session a expiré. Reconnectez-vous pour enregistrer votre accord.",
  "@legalGateErrorUnauthorized": { "description": "Refus d'enregistrement, 401. Aucun bouton : le retour à /auth se fait par la garde de route, l'écran ne navigue pas lui-même. Proposer « Réessayer » promettrait ce qui ne peut pas marcher" },
  "legalGateErrorOutdated": "Ces conditions ont été mises à jour.",
  "@legalGateErrorOutdated": { "description": "Refus d'enregistrement, 422 : une révision a paru entre la synchronisation et l'appui sur « Continuer ». Réessayer à l'identique échouerait toujours — l'issue est de RECHARGER le document" },
  "legalGateErrorServer": "Le serveur n'a pas pu enregistrer votre accord.",
  "@legalGateErrorServer": { "description": "Refus d'enregistrement, 5xx. Le serveur est joignable : ce n'est pas la connexion du fidèle qui est en cause. Suivi de « Réessayer »" },
  "legalGateReload": "Recharger",
  "@legalGateReload": { "description": "Issue du refus 422 : redemande le document au serveur. Pas « Réessayer » — ce n'est pas le même envoi qu'on rejoue, c'est le texte qu'on va chercher" },

  "legalNoticeBody": "En utilisant l'application, vous acceptez nos conditions d'utilisation et notre politique de confidentialité.",
  "@legalNoticeBody": { "description": "Mention légale NON bloquante du premier lancement, pour un invité. Elle existe parce que l'application attribue un identifiant à l'appareil dès l'ouverture — une donnée personnelle — et qu'un invité ne passe jamais par la barrière de consentement des membres (/legal/accept), seule à recueillir un accord explicite. Ce n'est donc pas une décoration : c'est le seul endroit où cela s'annonce à qui n'a pas de compte" },
  "legalNoticeTerms": "Conditions d'utilisation",
  "@legalNoticeTerms": { "description": "Lien du bandeau vers /legal/cgu. Un libellé propre plutôt que l'abrégé du menu latéral (drawerTerms, « CGU ») : ici il n'y a pas de contrainte de largeur, et un sigle dans une phrase de consentement se lit moins bien qu'un mot" },
  "legalNoticePrivacy": "Confidentialité",
  "@legalNoticePrivacy": { "description": "Lien du bandeau vers /legal/privacy. Abrégé, lui, parce qu'il partage sa ligne avec le lien des conditions et le bouton de fermeture" },
  "legalNoticeDismiss": "J'ai compris",
  "@legalNoticeDismiss": { "description": "Ferme le bandeau, définitivement (mémoire locale). Pas « Accepter » : il n'y a rien à cocher ni à envoyer ici — l'accord d'un invité est implicite par l'usage, et prétendre le recueillir donnerait à croire qu'il est tracé" },

  "appUpdateBody": "Une nouvelle version de l'application est disponible.",
  "@appUpdateBody": { "description": "Bandeau NON bloquant de mise à jour, affiché quand la version installée est sous le seuil réglé au portail. Il informe et renvoie au magasin ; il ne bloque rien, ne force rien, et l'application reste utilisable derrière. Tant qu'aucun seuil n'est réglé, il ne s'affiche pour personne" },
  "appUpdateAction": "Mettre à jour",
  "@appUpdateAction": { "description": "Ouvre la fiche de l'application dans le magasin. Un verbe d'action et non « Ouvrir le magasin » : ce qu'on vient faire est la mise à jour, le magasin n'en est que le chemin" },
  "appUpdateReload": "Recharger",
  "@appUpdateReload": { "description": "Le même bouton, dans un navigateur : il n'y a pas de magasin où aller, la nouvelle version est déjà servie et il suffit de recharger la page. Pas « Mettre à jour » : ici le geste est immédiat et sans départ vers une autre application, et le dire fait comprendre qu'on ne quitte rien" },
  "appUpdateDismiss": "Plus tard",
  "@appUpdateDismiss": { "description": "Ferme le bandeau pour la session en cours — pas définitivement, contrairement à legalNoticeDismiss. Pas « J'ai compris » : il n'y a rien à comprendre ici, seulement un geste qu'on remet à plus tard, et le bandeau reviendra au prochain lancement tant que la version n'aura pas monté" },

  "installBannerBody": "Installez l'application pour la retrouver dans vos applis, et pour télécharger les enseignements.",
  "@installBannerBody": { "description": "Bandeau d'installation de l'app web, affiché seulement dans un navigateur capable d'installer et quand ce n'est pas déjà fait. Il dit POURQUOI installer plutôt que « Installer l'application » : sans installation, Chrome n'accorde pas le stockage durable (navigator.storage.persist() rend non), donc pas de téléchargement hors ligne — mesuré le 29/10/2026" },
  "installBannerAction": "Installer",
  "@installBannerAction": { "description": "Ouvre la vraie boîte d'installation du navigateur (beforeinstallprompt différé). Un seul mot : le bandeau a déjà dit pourquoi" },
  "installBannerIosBody": "Pour l'installer : touchez Partager, puis « Sur l'écran d'accueil ».",
  "@installBannerIosBody": { "description": "Même bandeau sur iPhone et iPad, où aucun événement n'existe : Safari n'offre aucune boîte à déclencher, on ne peut qu'expliquer le geste. Pas de bouton d'action pour la même raison — un bouton qui n'ouvrirait rien serait une promesse que personne ne tient" },
  "installBannerDismiss": "Plus tard",
  "@installBannerDismiss": { "description": "Ferme le bandeau pour la session, comme appUpdateDismiss et non comme legalNoticeDismiss : l'invitation reste valable, elle reviendra au prochain lancement tant que l'application n'est pas installée" },

  "miniPlayerLiveBadge": "EN DIRECT",
  "@miniPlayerLiveBadge": { "description": "Mini-lecteur : badge d'un direct de la régie (#149), à la place de la ligne d'orateur. Affiché seulement quand l'antenne connue signale un direct (RadioAntenna.live) — jamais pour dire que la radio tourne, c'est miniPlayerOnAirBadge. Capitales voulues, comme un voyant d'antenne ; court, il tient dans une pastille rouge" },
  "miniPlayerOnAirBadge": "À l'antenne",
  "@miniPlayerOnAirBadge": { "description": "Mini-lecteur : badge de la radio hors direct (#149), à la place de la ligne d'orateur. Le mot de la page radio (radioLive) : la radio tourne 24 h/24, « EN DIRECT » est réservé au direct de la régie. Dit ce qu'on écoute, pas que le son sort — il reste en pause. Court : il tient dans une pastille" },
  "miniPlayerOpen": "Ouvrir le lecteur : {title}",
