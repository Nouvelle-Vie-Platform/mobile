  "miniPlayerSkipBackward": "Reculer de 30 secondes",
  "@miniPlayerSkipBackward": { "description": "Mini-lecteur : libellé d'accessibilité du bouton −30 s. Le pas est celui de la notification et de la fiche (kContentSkipInterval) ; si la constante change, ce texte change avec elle" },
  "miniPlayerSkipForward": "Avancer de 30 secondes",
  "@miniPlayerSkipForward": { "description": "Mini-lecteur : libellé d'accessibilité du bouton +30 s. Même pas que miniPlayerSkipBackward" },
  "miniPlayerReplay": "Rejouer",
  "@miniPlayerReplay": { "description": "Mini-lecteur : le gros bouton en fin de lecture. Relance depuis le début" },
  "miniPlayerRelaunch": "Relancer l'écoute",
  "@miniPlayerRelaunch": { "description": "Mini-lecteur : le gros bouton quand l'écoute a échoué avant d'avoir jamais commencé (pas de réseau à l'ouverture). Pas « Reprendre » : il n'y a aucune position à retrouver. Pas « Réessayer » non plus, mot banni du lecteur" },
  "miniPlayerClose": "Fermer le lecteur",
  "@miniPlayerClose": { "description": "Mini-lecteur : libellé d'accessibilité de la croix. Arrête le son, retire la notification et ferme le mini-lecteur ; la position de reprise est gardée" },

